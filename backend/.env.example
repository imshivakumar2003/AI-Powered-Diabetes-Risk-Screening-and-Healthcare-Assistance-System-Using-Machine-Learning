FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default: local SQLite file (backend/app.db). Zero setup required.
DATABASE_URL=sqlite:///app.db

# To switch to PostgreSQL later, comment out the line above and uncomment:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/diabetes_db

# To switch to MySQL later, comment out the SQLite line and uncomment:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/diabetes_db

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# IMPORTANT: generate a real random secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-change-me-in-production
JWT_EXPIRES_MINUTES=60
RESET_TOKEN_EXPIRES_MINUTES=30

# ---------------------------------------------------------------------------
# AI Health Suggestions & Chatbot (Groq API)
# ---------------------------------------------------------------------------
# Get an API key at https://console.groq.com/keys
# If left blank, the app automatically falls back to safe static suggestions
# so the feature never breaks — just less personalized.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Email (for "Email Report" feature) — optional
# ---------------------------------------------------------------------------
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an
# App Password (not your normal password) for SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
